# Copy to deploy/.env and fill in. deploy/.env is gitignored — never commit it.

# SSH connection to your Hostinger VPS
VPS_HOST=123.45.67.89          # your VPS IP or hostname
VPS_USER=root                  # SSH user
VPS_PORT=22                    # SSH port (Hostinger default is 22)
VPS_SSH_KEY=~/.ssh/id_ed25519  # path to your private key (omit to use password/agent)

# Where the site lives on the server (nginx web root)
VPS_PATH=/var/www/noteos.in

# Public domain (used only for the nginx config helper)
DOMAIN=noteos.in
